<Window x:Class="DevShell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:DevShell.UI"
        xmlns:ui="clr-namespace:DevShell.UI"
        xmlns:local="clr-namespace:DevShell"
        xmlns:svc="clr-namespace:DevShell.Services"
        Title="DevShell"
        WindowStyle="None"
        WindowStartupLocation="Manual"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        AllowDrop="True"
        DragOver="Bar_DragOver"
        Drop="Bar_Drop"
        Topmost="True"
        AllowsTransparency="False"
        Background="#FF12141B"
        Height="46"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <ui:FileIconConverter x:Key="FileIcon" />

        <DataTemplate x:Key="HitTemplate">
            <Grid Background="Transparent" ToolTip="{Binding Entry.Path}" ToolTipService.InitialShowDelay="600"
                  MouseRightButtonUp="Hit_RightClick">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Image Grid.Column="0" Width="20" Height="20" VerticalAlignment="Center"
                       Source="{Binding Entry, Converter={StaticResource FileIcon}}" />

                <StackPanel Grid.Column="1" Margin="10,0,10,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" Style="{StaticResource Caption}" FontSize="13"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Folder}" Style="{StaticResource CaptionDim}" FontSize="11"
                               TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,10,0">
                    <TextBlock Text="{Binding Kind}" Style="{StaticResource CaptionDim}" FontSize="11"
                               HorizontalAlignment="Right" />
                    <TextBlock Text="{Binding SizeText}" Style="{StaticResource CaptionDim}" FontSize="11"
                               HorizontalAlignment="Right" />
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource ChipButton}" Content="&#xE8E5;" Tag="{Binding}"
                            ToolTip="{l:Tr Hit_Open}" Click="HitOpen_Click" />
                    <Button Style="{StaticResource ChipButton}" Content="&#xE8B7;" Tag="{Binding}"
                            ToolTip="{l:Tr Hit_Location}" Click="HitLocation_Click" />
                    <Button Style="{StaticResource ChipButton}" Content="&#xEA18;" Tag="{Binding}"
                            ToolTip="{l:Tr Hit_Admin}" Click="HitAdmin_Click" />
                </StackPanel>

                <Grid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="{l:Tr Hit_Open}" Click="HitOpen_Click" />
                        <MenuItem Header="{l:Tr Hit_Admin}" Click="HitAdmin_Click" />
                        <MenuItem Header="{l:Tr Hit_Location}" Click="HitLocation_Click" />
                        <Separator />
                        <MenuItem Header="{l:Tr Hit_CopyPath}" Click="HitCopyPath_Click" />
                    </ContextMenu>
                </Grid.ContextMenu>
            </Grid>
        </DataTemplate>

        <!-- An app found in the Start menu's own list, with the same three actions a file hit has. -->
        <DataTemplate x:Key="AppHitTemplate">
            <Grid Background="Transparent" ToolTip="{Binding Path}" ToolTipService.InitialShowDelay="600"
                  MouseRightButtonUp="AppHit_RightClick">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Image Grid.Column="0" Width="20" Height="20" VerticalAlignment="Center"
                       Source="{Binding App.Icon}" RenderOptions.BitmapScalingMode="HighQuality" />

                <StackPanel Grid.Column="1" Margin="10,0,10,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" Style="{StaticResource Caption}" FontSize="13"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Folder}" Style="{StaticResource CaptionDim}" FontSize="11"
                               TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                </StackPanel>

                <TextBlock Grid.Column="2" Text="{Binding Kind}" Style="{StaticResource CaptionDim}"
                           FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0" />

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource ChipButton}" Content="&#xE8E5;" Tag="{Binding}"
                            ToolTip="{l:Tr Hit_Open}" Click="AppHitOpen_Click" />
                    <Button Style="{StaticResource ChipButton}" Content="&#xE8B7;" Tag="{Binding}"
                            ToolTip="{l:Tr Hit_ShowFolder}" Click="AppHitLocation_Click" />
                    <Button Style="{StaticResource ChipButton}" Content="&#xEA18;" Tag="{Binding}"
                            ToolTip="{l:Tr Hit_Admin}" Click="AppHitAdmin_Click" />
                </StackPanel>

                <Grid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="{l:Tr Hit_Open}" Click="AppHitOpen_Click" />
                        <MenuItem Header="{l:Tr Hit_Admin}" Click="AppHitAdmin_Click" />
                        <MenuItem Header="{l:Tr Hit_ShowFolder}" Click="AppHitLocation_Click" />
                        <Separator />
                        <MenuItem Header="{l:Tr Hit_CopyPath}" Click="AppHitCopyPath_Click" />
                    </ContextMenu>
                </Grid.ContextMenu>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="AppTemplate">
            <Button Style="{StaticResource TaskbarIcon}" Width="38" Height="36" Padding="0"
                    Tag="{Binding}" ToolTip="{Binding ToolTip}" Click="App_Click">
                <Image Source="{Binding Icon}" Width="24" Height="24"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <Button.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="{l:Tr Hit_Open}" Click="AppMenuOpen_Click" />
                        <MenuItem Header="{l:Tr Hit_Admin}" Click="AppMenuAdmin_Click" />
                        <MenuItem Header="{l:Tr Hit_Location}" Click="AppMenuLocation_Click" />
                        <Separator />
                        <MenuItem Header="{l:Tr Pin_Remove}" Click="AppMenuUnpin_Click" />
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>
        </DataTemplate>

        <!-- A running application: one button per app, marked while one of its windows is in front.
             A grouped application stacks its own icon behind the first one, and opens a preview of
             every window when the pointer rests on it. -->
        <DataTemplate x:Key="RunningTemplate">
            <Button Tag="{Binding}" ToolTip="{Binding ToolTip}" ToolTipService.InitialShowDelay="400"
                    Width="38" Height="36" Padding="0" Click="Running_Click"
                    MouseEnter="Running_MouseEnter" MouseLeave="Running_MouseLeave"
                    MouseRightButtonUp="Running_RightClick" Style="{StaticResource TaskbarIcon}">
                <Grid>
                    <!-- Three or more windows: a second, fainter silhouette further out. -->
                    <Image Source="{Binding Icon}" Width="16" Height="16" Opacity="0.25"
                           HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,-6,0"
                           RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.Style>
                            <Style TargetType="Image">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasManyWindows}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Image.Style>
                    </Image>

                    <!-- Two windows: the app's icon peeks out behind the first one. -->
                    <Image Source="{Binding Icon}" Width="20" Height="20" Opacity="0.5"
                           HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-3,-3,0"
                           RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.Style>
                            <Style TargetType="Image">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsGrouped}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Image.Style>
                    </Image>

                    <Image Source="{Binding Icon}" Width="24" Height="24"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <Border Height="3" Width="18" CornerRadius="2" VerticalAlignment="Bottom"
                            Margin="0,0,0,1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource Accent}" />
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsForeground}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                </Grid>
            </Button>
        </DataTemplate>

        <!-- One background application in the notification-area flyout: its icon and the tooltip it
             registered, which is the only text Explorer shows for one too. -->
        <DataTemplate x:Key="TrayItemTemplate">
            <Button Tag="{Binding}" Style="{StaticResource TrayItemRow}"
                    Click="TrayItem_Click" MouseRightButtonUp="TrayItem_RightClick"
                    ToolTip="{Binding Label}" ToolTipService.InitialShowDelay="700">
                <StackPanel Orientation="Horizontal">
                    <Image Source="{Binding Icon}" Width="16" Height="16"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Label}" Margin="8,0,0,0" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Button>
        </DataTemplate>

        <!-- One window of a grouped app in the hover preview: its still picture, its title, and a
             cross that closes just that window. -->
        <DataTemplate x:Key="RunningPreviewTemplate">
            <Button Tag="{Binding}" Style="{StaticResource RunningPreviewRow}"
                    Click="RunningPreview_Click" ToolTip="{Binding Title}"
                    ToolTipService.InitialShowDelay="1200">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="150" Height="84" CornerRadius="4"
                            Background="#33000000" ClipToBounds="True">
                        <Grid>
                            <Image Source="{Binding Thumbnail}" Stretch="Uniform" />
                            <Image Source="{Binding Icon}" Width="40" Height="40"
                                   RenderOptions.BitmapScalingMode="HighQuality">
                                <Image.Style>
                                    <Style TargetType="Image">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasThumbnail}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Image.Style>
                            </Image>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" Style="{StaticResource Caption}" FontSize="12"
                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="34" />
                        <TextBlock Text="{Binding State}" FontSize="11" Margin="0,2,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionDim}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding State}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <Button Grid.Column="2" Style="{StaticResource ChipButton}" Content="&#xE711;"
                            Tag="{Binding}" Click="RunningPreviewClose_Click"
                            ToolTip="{l:Tr Bar_CloseWindow}" VerticalAlignment="Center" />
                </Grid>
            </Button>
        </DataTemplate>

        <!-- A wireless network in the Wi-Fi list: signal bars, name, lock, state. -->
        <Style x:Key="WifiRow" TargetType="Button" BasedOn="{StaticResource BarButton}">
            <Setter Property="Focusable" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="8,6" Margin="0,0,0,3">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource HoverOverlay}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource PressedOverlay}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="WifiNetworkTemplate">
            <Button Style="{StaticResource WifiRow}" Click="WifiRow_Click"
                    ToolTip="{Binding Detail}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource Glyph}" FontSize="15"
                               VerticalAlignment="Center" Margin="0,0,8,0" Text="{Binding Bars}" />
                    <TextBlock Grid.Column="1" Style="{StaticResource Caption}" FontSize="12"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Text="{Binding Name}" />
                    <TextBlock Grid.Column="2" Style="{StaticResource Glyph}" FontSize="11" Opacity="0.7"
                               VerticalAlignment="Center" Margin="8,0,0,0" Text="{Binding Lock}" />
                    <TextBlock Grid.Column="3" Style="{StaticResource CaptionDim}" FontSize="11"
                               VerticalAlignment="Center" Margin="8,0,0,0" Text="{Binding Detail}" />
                </Grid>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="AdapterTemplate">
            <Border Padding="8,6" CornerRadius="6" Background="#0DFFFFFF" Margin="0,0,0,4">
                <StackPanel>
                    <TextBlock Text="{Binding Name}" Style="{StaticResource Caption}" FontSize="12" />
                    <TextBlock Text="{Binding Description}" Style="{StaticResource CaptionDim}" FontSize="11"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Detail}" Style="{StaticResource CaptionDim}" FontSize="11"
                               Foreground="{StaticResource TextFaint}" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="Root">

        <Border x:Name="BarSurface"
                Background="Transparent"
                BorderBrush="{StaticResource BarBorder}"
                BorderThickness="0,1,0,0">
            <Border.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="{l:Tr Menu_RebuildIndex}" Click="MenuRebuildIndex_Click" />
                    <Separator />
                    <MenuItem x:Name="MenuDockOverlay" Header="{l:Tr Menu_DockOverlay}"
                              IsCheckable="True" Click="MenuDockOverlay_Click" />
                    <MenuItem x:Name="MenuDockAppBar" Header="{l:Tr Menu_DockAppBar}"
                              IsCheckable="True" Click="MenuDockAppBar_Click" />
                    <MenuItem x:Name="MenuAcrylic" Header="{l:Tr Menu_Acrylic}" IsCheckable="True"
                              Click="MenuAcrylic_Click" />
                    <MenuItem x:Name="MenuShowDesktop" Header="{l:Tr Menu_ShowDesktop}" IsCheckable="True"
                              Click="MenuShowDesktop_Click" />
                    <Separator />
                    <MenuItem Header="{l:Tr Menu_TaskManager}" Click="MenuTaskManager_Click" />
                    <MenuItem Header="{l:Tr Menu_OpenSettingsFolder}" Click="MenuOpenDataFolder_Click" />
                    <MenuItem Header="{l:Tr Menu_Exit}" Click="MenuExit_Click" />
                </ContextMenu>
            </Border.ContextMenu>

            <Grid Margin="8,0,10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Start button: left click opens the Start menu, right click Windows' own power-user menu -->
                <Button x:Name="StartButton" Grid.Column="0" Style="{StaticResource BarButton}"
                        Width="42" Height="38" Click="Start_Click" ToolTip="{l:Tr Bar_Start}"
                        MouseRightButtonUp="Start_RightClick">
                    <!-- DevShell's own mark, the same image the settings flyout shows. -->
                    <Image x:Name="StartIcon" Width="24" Height="24" Stretch="Uniform"
                           Source="pack://application:,,,/Assets/DevShell.png"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                </Button>

                <!-- File search -->
                <Grid x:Name="SearchPill" Grid.Column="1" Width="320" Height="32" Margin="6,0,0,0"
                      VerticalAlignment="Center">
                    <Border Background="#26FFFFFF" CornerRadius="8" BorderThickness="1" BorderBrush="#1AFFFFFF" />
                    <Grid Margin="10,0,4,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource Glyph}" FontSize="14" Text="&#xE721;"
                                   Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
                        <Grid Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock x:Name="SearchPlaceholder" Text="{l:Tr Bar_Search}"
                                       Style="{StaticResource CaptionDim}" FontSize="13"
                                       VerticalAlignment="Center" IsHitTestVisible="False" />
                            <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0"
                                     Foreground="{StaticResource TextPrimary}"
                                     CaretBrush="{StaticResource TextPrimary}" FontSize="13"
                                     VerticalContentAlignment="Center" SelectionBrush="{StaticResource Accent}"
                                     TextChanged="SearchBox_TextChanged" GotFocus="SearchBox_GotFocus" />
                        </Grid>
                        <Button x:Name="SearchClearButton" Grid.Column="2" Style="{StaticResource ChipButton}"
                                Width="22" Height="22" Content="&#xE711;" ToolTip="{l:Tr Bar_Clear}"
                                Visibility="Collapsed" Click="SearchClear_Click" />
                    </Grid>
                </Grid>

                <!-- Pinned taskbar programs (the shell's own pinned folder), then whatever
                     currently has windows on screen -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0"
                            VerticalAlignment="Center">
                    <ItemsControl x:Name="PinnedItems" VerticalAlignment="Center"
                                  ItemTemplate="{StaticResource AppTemplate}"
                                  PreviewMouseLeftButtonDown="PinnedStrip_DragStart"
                                  PreviewMouseMove="PinnedStrip_DragMove">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <Border x:Name="RunningSeparator" Width="1" Height="22" Margin="6,0"
                            Background="{StaticResource BarBorder}" Visibility="Collapsed" />

                    <ItemsControl x:Name="RunningItems" VerticalAlignment="Center"
                                  ItemTemplate="{StaticResource RunningTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>

                <!-- Right cluster: clock, network, volume, activity, keyboard language -->

                <!-- Notification area: the chevron Explorer puts beside the clock. It only appears
                     while a background application has registered an icon through Shell_NotifyIcon. -->
                <Button x:Name="TrayButton" Grid.Column="4" Style="{StaticResource BarButton}"
                        Height="38" Padding="4,0" Click="Tray_Click" ToolTip="{l:Tr Bar_Running}"
                        Visibility="Collapsed">
                    <TextBlock Style="{StaticResource Glyph}" FontSize="12" Text="&#xE70E;"
                               VerticalAlignment="Center" HorizontalAlignment="Center" />
                </Button>

                <Button x:Name="ClockButton" Grid.Column="5" Style="{StaticResource BarButton}"
                        Height="38" Padding="8,0" Click="Clock_Click" ToolTip="{l:Tr Bar_Clock}">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="ClockTime" Style="{StaticResource Caption}" FontSize="12"
                                   HorizontalAlignment="Center" Text="--:--" />
                        <TextBlock x:Name="ClockDate" Style="{StaticResource CaptionDim}" FontSize="11"
                                   HorizontalAlignment="Center" Text="--.--.----" />
                    </StackPanel>
                </Button>

                <Button x:Name="NetworkButton" Grid.Column="6" Style="{StaticResource BarButton}"
                        Height="38" Padding="8,0" Click="Network_Click" MouseRightButtonUp="Network_RightClick"
                        ToolTip="{l:Tr Bar_Network}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="NetworkGlyph" Style="{StaticResource Glyph}" FontSize="15"
                                   Text="&#xE701;" />
                        <TextBlock x:Name="NetworkLabel" Style="{StaticResource CaptionDim}" FontSize="11"
                                   Margin="6,0,0,0" VerticalAlignment="Center" Text="{l:Tr Bar_Checking}" />
                    </StackPanel>
                </Button>

                <Grid Grid.Column="7" Width="54" Height="40" ToolTip="{l:Tr Bar_Volume}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Button x:Name="VolumeButton" Style="{StaticResource BarButton}" Height="28"
                            Click="Volume_Click" MouseRightButtonUp="Volume_RightClick">
                        <TextBlock x:Name="VolumeGlyph" Style="{StaticResource Glyph}" FontSize="15"
                                   Text="&#xE767;" />
                    </Button>
                    <Slider x:Name="VolumeBar" Grid.Row="1" Style="{StaticResource VolumeBarSlider}"
                            Margin="7,0,7,5" ValueChanged="VolumeBar_ValueChanged" />
                </Grid>

                <Button x:Name="ActivityButton" Grid.Column="8" Style="{StaticResource BarButton}"
                        Height="38" Padding="8,0" Click="Activity_Click"
                        ToolTip="{l:Tr Bar_Activity}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Glyph}" FontSize="11" Text="&#xE896;"
                                           Foreground="#FF6FD08C" VerticalAlignment="Center" />
                                <TextBlock x:Name="DownRateText" Style="{StaticResource Caption}" FontSize="10"
                                           Margin="4,0,0,0" VerticalAlignment="Center" Text="0 B/s" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Glyph}" FontSize="11" Text="&#xE898;"
                                           Foreground="#FFE0A35C" VerticalAlignment="Center" />
                                <TextBlock x:Name="UpRateText" Style="{StaticResource Caption}" FontSize="10"
                                           Margin="4,0,0,0" VerticalAlignment="Center" Text="0 B/s" />
                            </StackPanel>
                        </StackPanel>
                        <Canvas x:Name="SparkCanvas" Grid.Column="1" Width="74" Height="28"
                                VerticalAlignment="Center" ClipToBounds="True">
                            <Polyline x:Name="DownloadSpark" Stroke="#FF6FD08C" StrokeThickness="1.4" />
                            <Polyline x:Name="UploadSpark" Stroke="#FFE0A35C" StrokeThickness="1.1" />
                            <Line x:Name="SparkBaseline" X1="0" Y1="27" X2="74" Y2="27"
                                  Stroke="#22FFFFFF" StrokeThickness="1" />
                        </Canvas>
                    </Grid>
                </Button>

                <Button x:Name="LanguageButton" Grid.Column="9" Style="{StaticResource BarButton}"
                        Height="38" Padding="8,0" Click="Language_Click" ToolTip="{l:Tr Bar_Keyboard}">
                    <TextBlock x:Name="LanguageText" Style="{StaticResource Caption}" FontSize="11"
                               VerticalAlignment="Center" Text="---" />
                </Button>
            </Grid>
        </Border>

        <!-- ============ flyouts ============ -->

        <Popup x:Name="SearchPopup" AllowsTransparency="True" StaysOpen="False"
               PopupAnimation="Fade" Placement="Relative">
            <Border Style="{StaticResource PopupCard}" Padding="8" Width="940">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Two tabs, the same pair the Start menu uses: the Start menu's own app list,
                         and the file index. The query is shared and each tab keeps its own hits. -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="4,0,0,2">
                        <StackPanel>
                            <Button x:Name="SearchTabAppsButton" Style="{StaticResource StartTabButton}"
                                    Content="{l:Tr Search_TabApps}" Click="SearchTabApps_Click" />
                            <Border x:Name="SearchTabAppsUnderline" Height="2" CornerRadius="1"
                                    Background="{StaticResource Accent}" Visibility="Collapsed" />
                        </StackPanel>
                        <StackPanel Margin="6,0,0,0">
                            <Button x:Name="SearchTabFilesButton" Style="{StaticResource StartTabButton}"
                                    Content="{l:Tr Search_TabFiles}" Click="SearchTabFiles_Click" />
                            <Border x:Name="SearchTabFilesUnderline" Height="2" CornerRadius="1"
                                    Background="{StaticResource Accent}" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock x:Name="NoResults" Grid.Row="1" Style="{StaticResource CaptionDim}"
                               Margin="12,22,12,22" TextAlignment="Center" Visibility="Collapsed" />

                    <ListBox x:Name="ResultsList" Grid.Row="1" Style="{StaticResource FlyoutList}"
                             MaxHeight="440" MouseDoubleClick="ResultsList_MouseDoubleClick" />

                    <ListBox x:Name="AppResultsList" Grid.Row="1" Style="{StaticResource FlyoutList}"
                             MaxHeight="440" Visibility="Collapsed"
                             MouseDoubleClick="AppResultsList_MouseDoubleClick" />

                    <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="#1AFFFFFF" Padding="6,6,6,2"
                            Margin="0,6,0,0">
                        <Grid>
                            <TextBlock x:Name="SearchStatus" Style="{StaticResource CaptionDim}" FontSize="11"
                                       HorizontalAlignment="Left" />
                            <TextBlock Style="{StaticResource CaptionDim}" FontSize="11"
                                       HorizontalAlignment="Right" Foreground="{StaticResource TextFaint}"
                                       Text="{l:Tr Search_Hint}" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Popup>

        <Popup x:Name="StartPopup" AllowsTransparency="True" StaysOpen="False"
               PopupAnimation="Fade" Placement="Relative">
            <Border Style="{StaticResource PopupCard}" Padding="0" Width="560">
                <Grid Height="540">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="56" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- The rail: who is signed in at the top, then Settings with the power menu
                         under it, the way Windows puts them at the bottom of its own Start menu. -->
                    <DockPanel Grid.Column="0" Background="#14FFFFFF">
                        <Button x:Name="StartAccountButton" DockPanel.Dock="Top" Style="{StaticResource BarButton}"
                                Width="48" Height="40" Padding="0" Margin="4,10,4,0" FontSize="18"
                                FontFamily="{DynamicResource IconFont}" Content="&#xE77B;" Click="StartAccount_Click" />
                        <StackPanel DockPanel.Dock="Bottom" Margin="4,0,4,10">
                            <!-- DevShell's own settings; it wears the icon embedded in this build. -->
                            <Button x:Name="StartDevShellButton" Style="{StaticResource BarButton}" Width="48"
                                    Height="40" Padding="0" ToolTip="{l:Tr Start_DevShellSettings}"
                                    Click="StartDevShell_Click">
                                <Image x:Name="StartDevShellIcon" Width="24" Height="24"
                                       Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                            </Button>
                            <Button x:Name="StartSettingsButton" Style="{StaticResource BarButton}" Width="48"
                                    Height="40" Padding="0" FontSize="18" FontFamily="{DynamicResource IconFont}"
                                    Content="&#xE713;" ToolTip="{l:Tr Start_Settings}" Click="StartSettings_Click" />
                            <Button x:Name="StartPowerButton" Style="{StaticResource BarButton}" Width="48"
                                    Height="40" Padding="0" FontSize="18" FontFamily="{DynamicResource IconFont}"
                                    Content="&#xE7E8;" ToolTip="{l:Tr Start_Power}" Click="StartPower_Click" />
                        </StackPanel>
                        <TextBlock />
                    </DockPanel>

                    <DockPanel Grid.Column="1" Margin="12,12,8,12">
                        <TextBlock x:Name="StartHeader" DockPanel.Dock="Top" Style="{StaticResource Caption}"
                                   FontSize="14" FontWeight="SemiBold" Margin="2,0,0,6"
                                   TextTrimming="CharacterEllipsis" />

                        <!-- Two tabs: the programs, and what this build of DevShell is. The mark on
                             the second one is the artwork embedded in this build, not the desktop. -->
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                            <StackPanel>
                                <Button x:Name="StartTabAppsButton" Style="{StaticResource StartTabButton}"
                                        Content="{l:Tr Start_AllApps}" Click="StartTabApps_Click" />
                                <Border x:Name="StartTabAppsUnderline" Height="2" CornerRadius="1"
                                        Background="{StaticResource Accent}" />
                            </StackPanel>
                            <StackPanel Margin="6,0,0,0">
                                <Button x:Name="StartTabInfoButton" Style="{StaticResource StartTabButton}"
                                        Click="StartTabInfo_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Image x:Name="StartTabInfoIcon" Width="16" Height="16"
                                               Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                        <TextBlock Text="{l:Tr Info_Title}" Margin="6,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Border x:Name="StartTabInfoUnderline" Height="2" CornerRadius="1"
                                        Background="{StaticResource Accent}" Visibility="Collapsed" />
                            </StackPanel>
                        </StackPanel>

                        <Grid>
                            <!-- The programs Windows lists, read from the two Start Menu folders and
                                 kept in the folders Windows groups them in: one heading per folder,
                                 then the programs in it. -->
                            <ListBox x:Name="StartList" Style="{StaticResource FlyoutList}" MaxHeight="470"
                                     ItemContainerStyle="{StaticResource StartRow}">
                                <ListBox.Resources>
                                    <!-- A folder heading. It is not a row you can click or hover:
                                         the container style turns hit testing off for it. -->
                                    <DataTemplate DataType="{x:Type local:StartGroupRow}">
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource CaptionDim}"
                                                   FontSize="11" FontWeight="SemiBold" Margin="10,10,4,5"
                                                   TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>

                                    <DataTemplate DataType="{x:Type svc:StartApp}">
                                        <Grid Background="Transparent" ToolTip="{Binding ToolTip}"
                                              ToolTipService.InitialShowDelay="600"
                                              MouseLeftButtonUp="StartApp_Click"
                                              MouseRightButtonUp="StartApp_RightClick"
                                              PreviewMouseLeftButtonDown="StartApp_DragStart"
                                              PreviewMouseMove="StartApp_DragMove">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <Image Grid.Column="0" Width="20" Height="20" VerticalAlignment="Center"
                                                   Source="{Binding Icon}" />

                                            <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                       Style="{StaticResource Caption}" FontSize="13"
                                                       Margin="10,0,4,0" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.Resources>
                            </ListBox>

                            <!-- The DevShell tab: banner, version, and the details worth pasting into
                                 a bug report. Filled in each time the tab is shown. -->
                            <ScrollViewer x:Name="StartInfoPanel" Visibility="Collapsed"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Margin="2,0,2,4">
                                    <!-- The artwork is pure black, so its frame is black too: the
                                         picture fills the card with no seam and no letterboxing. -->
                                    <Border Background="Black" CornerRadius="8" ClipToBounds="True"
                                            BorderThickness="1" BorderBrush="#22FFFFFF">
                                        <Image x:Name="StartInfoBanner" Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Border>

                                    <Grid Margin="2,14,2,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Image x:Name="StartInfoIcon" Grid.Column="0" Width="36" Height="36"
                                               Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                        <StackPanel Grid.Column="1" Margin="10,0,10,0"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="{l:Tr Info_Title}" Style="{StaticResource Caption}"
                                                       FontSize="17" FontWeight="SemiBold" />
                                            <TextBlock Text="{l:Tr Info_Tagline}"
                                                       Style="{StaticResource CaptionDim}" FontSize="11"
                                                       Margin="0,1,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Border Grid.Column="2" CornerRadius="10" Padding="9,3"
                                                Background="{StaticResource AccentSoft}"
                                                VerticalAlignment="Center">
                                            <TextBlock x:Name="StartInfoVersion" Style="{StaticResource Caption}"
                                                       FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{StaticResource Accent}" />
                                        </Border>
                                    </Grid>

                                    <TextBlock Text="{l:Tr Info_Technical}" Style="{StaticResource CaptionDim}"
                                               FontSize="10" FontWeight="SemiBold" Margin="2,16,0,8" />
                                    <StackPanel x:Name="StartInfoRows" />

                                    <StackPanel Orientation="Horizontal" Margin="2,10,0,0">
                                        <Button x:Name="StartInfoCopyButton" Style="{StaticResource ChipButton}"
                                                Width="Auto" Height="28" Padding="12,0" FontSize="12"
                                                FontFamily="{StaticResource TextFont}"
                                                Foreground="{StaticResource TextPrimary}"
                                                Content="{l:Tr Info_CopyDetails}" Click="StartInfoCopy_Click" />
                                        <Button Style="{StaticResource ChipButton}" Width="Auto" Height="28"
                                                Padding="12,0" FontSize="12" Margin="6,0,0,0"
                                                FontFamily="{StaticResource TextFont}"
                                                Foreground="{StaticResource TextPrimary}"
                                                Content="{l:Tr Info_DataFolder}" Click="StartInfoFolder_Click" />
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </DockPanel>
                </Grid>
            </Border>
        </Popup>

        <!-- DevShell's own settings, opened from the rail of the Start menu. Everything in here
             writes to the one shared config file and applies on the spot. -->
        <Popup x:Name="SettingsPopup" AllowsTransparency="True" StaysOpen="False"
               PopupAnimation="Fade" Placement="Relative">
            <Border Style="{StaticResource PopupCard}" Width="396">
                <StackPanel Margin="16,14,16,16">
                    <TextBlock Text="{l:Tr Settings_Title}" Style="{StaticResource Caption}" FontSize="15"
                               FontWeight="SemiBold" Margin="2,0,0,12" />

                    <TextBlock Text="{l:Tr Settings_Desktop}" Style="{StaticResource CaptionDim}" FontSize="10"
                               FontWeight="SemiBold" Margin="2,0,0,8" />
                    <CheckBox x:Name="SetShowDesktopIcons" Content="{l:Tr Settings_ShowDesktopIcons}"
                              Foreground="{StaticResource TextPrimary}" Margin="2,3,0,3"
                              Click="SetShowDesktopIcons_Click" />
                    <CheckBox x:Name="SetIncludePublic" Content="{l:Tr Settings_IncludePublic}"
                              Foreground="{StaticResource TextPrimary}" Margin="2,3,0,3"
                              Click="SetIncludePublic_Click" />
                    <CheckBox x:Name="SetShowRecycleBin" Content="{l:Tr Settings_ShowRecycleBin}"
                              Foreground="{StaticResource TextPrimary}" Margin="2,3,0,3"
                              Click="SetShowRecycleBin_Click" />
                    <CheckBox x:Name="SetShowHidden" Content="{l:Tr Settings_ShowHidden}"
                              Foreground="{StaticResource TextPrimary}" Margin="2,3,0,3"
                              Click="SetShowHidden_Click" />
                    <CheckBox x:Name="SetShowExtensions" Content="{l:Tr Settings_ShowExtensions}"
                              Foreground="{StaticResource TextPrimary}" Margin="2,3,0,3"
                              Click="SetShowExtensions_Click" />

                    <Grid Margin="2,12,2,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{l:Tr Settings_IconSize}" Style="{StaticResource CaptionDim}"
                                   VerticalAlignment="Center" />
                        <Slider x:Name="SetIconSize" Grid.Column="1" Margin="10,0" Minimum="32"
                                Maximum="96" TickFrequency="8" IsSnapToTickEnabled="True"
                                VerticalAlignment="Center" Style="{StaticResource VolumeFlyoutSlider}"
                                ValueChanged="SetIconSize_Changed" />
                        <TextBlock x:Name="SetIconSizeText" Grid.Column="2" Style="{StaticResource Caption}"
                                   MinWidth="40" VerticalAlignment="Center" />
                    </Grid>

                    <Grid Margin="2,12,2,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Style="{StaticResource BarButton}" Content="{l:Tr Settings_Arrange}"
                                Padding="10,6" HorizontalAlignment="Left" Background="#14FFFFFF"
                                Click="SettingsArrange_Click" />
                        <Button Grid.Column="1" Style="{StaticResource BarButton}" Content="{l:Tr Settings_Refresh}"
                                Padding="10,6" Margin="6,0,0,0" Background="#14FFFFFF"
                                Click="SettingsRefresh_Click" />
                        <Button Grid.Column="2" Style="{StaticResource BarButton}" Content="{l:Tr Settings_Folder}"
                                Padding="10,6" Margin="6,0,0,0" Background="#14FFFFFF"
                                Click="OpenDataFolder_Click" />
                    </Grid>

                    <TextBlock Text="{l:Tr Settings_Bar}" Style="{StaticResource CaptionDim}" FontSize="10"
                               FontWeight="SemiBold" Margin="2,14,0,8" />
                    <CheckBox x:Name="SetAcrylic" Content="{l:Tr Settings_Acrylic}"
                              Foreground="{StaticResource TextPrimary}" Margin="2,3,0,3"
                              Click="SetAcrylic_Click" />
                    <CheckBox x:Name="SetSeconds" Content="{l:Tr Settings_Seconds}"
                              Foreground="{StaticResource TextPrimary}" Margin="2,3,0,3"
                              Click="SetSeconds_Click" />

                    <Grid Margin="2,12,2,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{l:Tr Settings_Transparency}" Style="{StaticResource CaptionDim}"
                                   VerticalAlignment="Center" />
                        <Slider x:Name="SetBarTransparency" Grid.Column="1" Margin="10,0" Minimum="0"
                                Maximum="85" TickFrequency="5" IsSnapToTickEnabled="True"
                                VerticalAlignment="Center" Style="{StaticResource VolumeFlyoutSlider}"
                                ValueChanged="SetBarTransparency_Changed" />
                        <TextBlock x:Name="SetBarTransparencyText" Grid.Column="2"
                                   Style="{StaticResource Caption}" MinWidth="40"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <TextBlock Text="{l:Tr Settings_Windows}" Style="{StaticResource CaptionDim}" FontSize="10"
                               FontWeight="SemiBold" Margin="2,14,0,8" />
                    <RadioButton x:Name="SetShellReplace" GroupName="ShellMode" Margin="2,3,0,3"
                                 Foreground="{StaticResource TextPrimary}" Content="{l:Tr Settings_ShellMode}"
                                 Checked="SetShellMode_Changed" />
                    <RadioButton x:Name="SetShellAlongside" GroupName="ShellMode" Margin="2,3,0,3"
                                 Foreground="{StaticResource TextPrimary}" Content="{l:Tr Settings_Alongside}"
                                 Checked="SetShellMode_Changed" />
                    <TextBlock x:Name="SetShellHint" Style="{StaticResource CaptionDim}" TextWrapping="Wrap"
                               Margin="2,5,0,0" />

                    <TextBlock Text="{l:Tr Settings_Troubleshooters}" Style="{StaticResource CaptionDim}" FontSize="10"
                               FontWeight="SemiBold" Margin="2,14,0,8" />
                    <RadioButton x:Name="SetTroubleshootClassic" GroupName="Troubleshooters" Margin="2,3,0,3"
                                 Foreground="{StaticResource TextPrimary}" Content="{l:Tr Settings_Classic}"
                                 Checked="SetTroubleshooter_Changed" />
                    <RadioButton x:Name="SetTroubleshootGetHelp" GroupName="Troubleshooters" Margin="2,3,0,3"
                                 Foreground="{StaticResource TextPrimary}" Content="{l:Tr Settings_GetHelp}"
                                 Checked="SetTroubleshooter_Changed" />
                    <TextBlock x:Name="SetTroubleshooterHint" Style="{StaticResource CaptionDim}" TextWrapping="Wrap"
                               Margin="2,5,0,0" />

                    <TextBlock Text="{l:Tr Settings_Language}" Style="{StaticResource CaptionDim}" FontSize="10"
                               FontWeight="SemiBold" Margin="2,14,0,8" />
                    <UniformGrid Columns="2">
                        <RadioButton x:Name="SetLanguageAuto" GroupName="Language" Tag="auto" Margin="2,3,0,3"
                                     Foreground="{StaticResource TextPrimary}" Content="{l:Tr Settings_LanguageAuto}"
                                     Checked="SetLanguage_Changed" />
                        <RadioButton x:Name="SetLanguageEn" GroupName="Language" Tag="en" Margin="2,3,0,3"
                                     Foreground="{StaticResource TextPrimary}" Content="English"
                                     Checked="SetLanguage_Changed" />
                        <RadioButton x:Name="SetLanguageRu" GroupName="Language" Tag="ru" Margin="2,3,0,3"
                                     Foreground="{StaticResource TextPrimary}" Content="Русский"
                                     Checked="SetLanguage_Changed" />
                        <RadioButton x:Name="SetLanguageDe" GroupName="Language" Tag="de" Margin="2,3,0,3"
                                     Foreground="{StaticResource TextPrimary}" Content="Deutsch"
                                     Checked="SetLanguage_Changed" />
                        <RadioButton x:Name="SetLanguageFr" GroupName="Language" Tag="fr" Margin="2,3,0,3"
                                     Foreground="{StaticResource TextPrimary}" Content="Français"
                                     Checked="SetLanguage_Changed" />
                        <RadioButton x:Name="SetLanguageEs" GroupName="Language" Tag="es" Margin="2,3,0,3"
                                     Foreground="{StaticResource TextPrimary}" Content="Español"
                                     Checked="SetLanguage_Changed" />
                    </UniformGrid>
                </StackPanel>
            </Border>
        </Popup>

        <Popup x:Name="ClockPopup" AllowsTransparency="True" StaysOpen="False"
               PopupAnimation="Fade" Placement="Relative">
            <Border Style="{StaticResource PopupCard}" Width="272">
                <StackPanel>
                    <TextBlock x:Name="ClockPopupTime" Style="{StaticResource Caption}" FontSize="30"
                               HorizontalAlignment="Center" />
                    <TextBlock x:Name="ClockPopupDate" Style="{StaticResource CaptionDim}"
                               HorizontalAlignment="Center" Margin="0,2,0,10" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Style="{StaticResource ChipButton}" Content="&#xE76B;"
                                Click="CalendarPrev_Click" ToolTip="{l:Tr Calendar_PreviousMonth}" />
                        <TextBlock x:Name="CalendarTitle" Grid.Column="1" Style="{StaticResource Caption}"
                                   FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Button Grid.Column="2" Style="{StaticResource ChipButton}" Content="&#xE76C;"
                                Click="CalendarNext_Click" ToolTip="{l:Tr Calendar_NextMonth}" />
                    </Grid>
                    <Grid x:Name="CalendarGrid" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
        </Popup>

        <Popup x:Name="NetworkPopup" AllowsTransparency="True" StaysOpen="False"
               PopupAnimation="Fade" Placement="Relative">
            <Border Style="{StaticResource PopupCard}" Width="400">
                <StackPanel>
                    <TextBlock x:Name="NetworkPopupTitle" Style="{StaticResource Caption}" FontSize="14"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="NetworkPopupSummary" Style="{StaticResource CaptionDim}"
                               TextWrapping="Wrap" Margin="0,6,0,10" />
                    <!-- Wi-Fi. Hidden entirely on a machine with no wireless adapter. -->
                    <StackPanel x:Name="WifiSection" Visibility="Collapsed" Margin="0,0,0,12">
                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="{l:Tr Wifi_Title}" Style="{StaticResource Caption}" FontSize="13" />
                            <Button x:Name="WifiScanButton" Style="{StaticResource ChipButton}" Content="&#xE72C;"
                                    HorizontalAlignment="Right" ToolTip="{l:Tr Wifi_Scan}" Click="WifiScan_Click" />
                        </Grid>
                        <TextBlock x:Name="WifiStatusText" Style="{StaticResource CaptionDim}" FontSize="11"
                                   TextTrimming="CharacterEllipsis" Margin="0,0,0,6" />
                        <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="WifiList" ItemTemplate="{StaticResource WifiNetworkTemplate}" />
                        </ScrollViewer>
                        <Border x:Name="WifiJoinPanel" Visibility="Collapsed" Margin="0,8,0,0" Padding="10"
                                CornerRadius="6" Background="#1AFFFFFF">
                            <StackPanel>
                                <TextBlock x:Name="WifiJoinTitle" Style="{StaticResource Caption}" FontSize="12"
                                           TextTrimming="CharacterEllipsis" />
                                <PasswordBox x:Name="WifiPassword" Margin="0,8,0,0" Padding="8,5" FontSize="12"
                                             FontFamily="{StaticResource TextFont}"
                                             Background="#26000000" Foreground="{StaticResource TextPrimary}"
                                             CaretBrush="{StaticResource TextPrimary}"
                                             BorderBrush="{StaticResource FlyoutBorder}" BorderThickness="1"
                                             KeyDown="WifiPassword_KeyDown" />
                                <TextBlock x:Name="WifiJoinHint" Style="{StaticResource CaptionDim}" FontSize="11"
                                           TextWrapping="Wrap" Margin="0,6,0,0" />
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button x:Name="WifiJoinButton" Style="{StaticResource ChipButton}"
                                            Width="Auto" Height="28" Padding="14,0" FontSize="12"
                                            FontFamily="{StaticResource TextFont}"
                                            Foreground="{StaticResource TextPrimary}"
                                            Content="{l:Tr Wifi_Connect}" Click="WifiJoin_Click" />
                                    <Button Style="{StaticResource ChipButton}" Width="Auto" Height="28"
                                            Padding="14,0" FontSize="12" Margin="6,0,0,0"
                                            FontFamily="{StaticResource TextFont}"
                                            Foreground="{StaticResource TextSecondary}"
                                            Content="{l:Tr Wifi_Cancel}" Click="WifiJoinCancel_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <TextBlock Text="{l:Tr Wifi_Adapters}" Style="{StaticResource CaptionDim}" FontSize="11"
                               Foreground="{StaticResource TextFaint}" Margin="0,0,0,6" />
                    <ScrollViewer MaxHeight="130" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="AdapterList" ItemTemplate="{StaticResource AdapterTemplate}" />
                    </ScrollViewer>
                </StackPanel>
            </Border>
        </Popup>

        <Popup x:Name="VolumePopup" AllowsTransparency="True" StaysOpen="False"
               PopupAnimation="Fade" Placement="Relative">
            <Border Style="{StaticResource PopupCard}" Width="300">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="VolumePopupMuteButton" Grid.Column="0" Style="{StaticResource ChipButton}"
                                Width="30" Height="30" FontSize="16" Click="VolumeMute_Click" />
                        <TextBlock x:Name="VolumePopupPercent" Grid.Column="1" Style="{StaticResource Caption}"
                                   FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Right" />
                    </Grid>
                    <Slider x:Name="VolumePopupSlider" Style="{StaticResource VolumeFlyoutSlider}"
                            Margin="0,14,0,4" ValueChanged="VolumePopupSlider_ValueChanged" />
                    <TextBlock x:Name="VolumePopupDevice" Style="{StaticResource CaptionDim}" FontSize="11"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
        </Popup>

        <Popup x:Name="ActivityPopup" AllowsTransparency="True" StaysOpen="False"
               PopupAnimation="Fade" Placement="Relative">
            <Border Style="{StaticResource PopupCard}" Width="392">
                <StackPanel>
                    <TextBlock Text="{l:Tr Net_Activity}" Style="{StaticResource Caption}" FontSize="14"
                               FontWeight="SemiBold" />
                    <Grid Margin="0,10,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="ActivityDown" Grid.Row="0" Style="{StaticResource Caption}"
                                   FontSize="12" />
                        <TextBlock x:Name="ActivityUp" Grid.Row="1" Style="{StaticResource Caption}"
                                   FontSize="12" />
                    </Grid>
                    <Canvas x:Name="ActivityCanvas" Height="86" Margin="0,10,0,0" ClipToBounds="True"
                            Background="#0DFFFFFF">
                        <Polyline x:Name="ActivityDownloadSpark" Stroke="#FF6FD08C" StrokeThickness="1.6" />
                        <Polyline x:Name="ActivityUploadSpark" Stroke="#FFE0A35C" StrokeThickness="1.2" />
                    </Canvas>
                    <Grid Margin="0,10,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="ActivityTotals" Grid.Row="0" Style="{StaticResource CaptionDim}"
                                   FontSize="11" />
                        <TextBlock x:Name="ActivityPeak" Grid.Row="1" Style="{StaticResource CaptionDim}"
                                   FontSize="11" />
                        <TextBlock x:Name="ActivitySince" Grid.Row="2" Style="{StaticResource CaptionDim}"
                                   FontSize="11" Foreground="{StaticResource TextFaint}" />
                    </Grid>
                </StackPanel>
            </Border>
        </Popup>

        <!-- The running-app hover preview: one row per window of a grouped application. StaysOpen
             is on because a popup that captures the pointer would stop the bar's buttons from
             noticing the pointer at all; the card closes itself when the pointer leaves it. -->
        <Popup x:Name="RunningPopup" AllowsTransparency="True" StaysOpen="True"
               PopupAnimation="Fade" Placement="Relative">
            <Border x:Name="RunningPreviewCard" Style="{StaticResource PopupCard}" Padding="6"
                    Width="320" MouseEnter="RunningPreviewCard_MouseEnter"
                    MouseLeave="RunningPreviewCard_MouseLeave">
                <ScrollViewer MaxHeight="500" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="RunningPreviewItems"
                                  ItemTemplate="{StaticResource RunningPreviewTemplate}" />
                </ScrollViewer>
            </Border>
        </Popup>

        <!-- The notification area's overflow: every icon background applications registered, in
             the order they registered it. Left click asks the owner to activate itself, right click
             asks it for its menu - the same contract Explorer implements. -->
        <Popup x:Name="TrayPopup" AllowsTransparency="True" StaysOpen="False"
               PopupAnimation="Fade" Placement="Relative">
            <Border Style="{StaticResource PopupCard}" Padding="6" Width="264">
                <StackPanel>
                    <TextBlock Text="{l:Tr Tray_Title}" Style="{StaticResource CaptionDim}"
                               FontSize="11" Margin="6,4,6,6" />
                    <ItemsControl x:Name="TrayItems"
                                  ItemTemplate="{StaticResource TrayItemTemplate}" />
                    <TextBlock x:Name="TrayEmpty" Text="{l:Tr Tray_Empty}"
                               Style="{StaticResource CaptionDim}" FontSize="11"
                               Margin="6,4,6,6" TextWrapping="Wrap" Visibility="Collapsed" />
                </StackPanel>
            </Border>
        </Popup>

    </Grid>
</Window>
