<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Icon glyphs come from Segoe Fluent Icons (Windows 11), with Segoe MDL2 Assets declared as the
         fallback so the same glyphs draw on Windows 10, where Fluent Icons does not exist at all.
         Every code point DevShell uses was checked against both fonts and is present in each:
         E701 E711 E713 E721 E74F E767 E76B E76C E779 E77B E7BA E7E8 E839 E896 E898 E8B7 E8E5 EA18.

         Consumed with DynamicResource on purpose. A StaticResource is resolved while these
         dictionaries are parsed - long before any code runs - so a family swapped at runtime cannot
         reach it. That is exactly how the Windows 10 glyphs went missing. -->
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <FontFamily x:Key="TextFont">Segoe UI Variable Text, Segoe UI</FontFamily>

    <SolidColorBrush x:Key="BarBorder" Color="#26FFFFFF" />
    <SolidColorBrush x:Key="FlyoutBackground" Color="#F2151720" />
    <SolidColorBrush x:Key="FlyoutBorder" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="TextPrimary" Color="#FFF2F4F8" />
    <SolidColorBrush x:Key="TextSecondary" Color="#FF9AA3B2" />
    <SolidColorBrush x:Key="TextFaint" Color="#FF6C7484" />
    <SolidColorBrush x:Key="Accent" Color="#FF4C8DFF" />
    <SolidColorBrush x:Key="AccentSoft" Color="#3D4C8DFF" />
    <!-- AccentSoft composited over FlyoutBackground: the same accent highlight, but opaque. The name
         of a selected desktop icon is shown in full, so its tile is wider than its own cell and can
         cover a neighbour - a see-through tile would let that neighbour show through the name. -->
    <SolidColorBrush x:Key="SelectedTile" Color="#FF223355" />
    <SolidColorBrush x:Key="HoverOverlay" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="PressedOverlay" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="TrackRest" Color="#33FFFFFF" />

    <Style x:Key="BarButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        <Setter Property="FontFamily" Value="{StaticResource TextFont}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource HoverOverlay}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource PressedOverlay}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A taskbar icon: the bar's own button with the icon itself answering the pointer. Hovering
         lifts it, a press pushes it in, and an application that has just come to the front bounces
         once - the three cues the Windows taskbar gives. Every one of them is a RenderTransform, so
         no animation can move the bar's layout or push its neighbours around. -->
    <QuadraticEase x:Key="LiftEase" EasingMode="EaseOut" />
    <CubicEase x:Key="SettleEase" EasingMode="EaseOut" />

    <Style x:Key="TaskbarIcon" TargetType="Button" BasedOn="{StaticResource BarButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="6"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="Pop" ScaleX="1" ScaleY="1" />
                        </Border.RenderTransform>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource HoverOverlay}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Pop" Storyboard.TargetProperty="ScaleX"
                                                         To="1.14" Duration="0:0:0.13" EasingFunction="{StaticResource LiftEase}" />
                                        <DoubleAnimation Storyboard.TargetName="Pop" Storyboard.TargetProperty="ScaleY"
                                                         To="1.14" Duration="0:0:0.13" EasingFunction="{StaticResource LiftEase}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Pop" Storyboard.TargetProperty="ScaleX"
                                                         To="1" Duration="0:0:0.16" EasingFunction="{StaticResource SettleEase}" />
                                        <DoubleAnimation Storyboard.TargetName="Pop" Storyboard.TargetProperty="ScaleY"
                                                         To="1" Duration="0:0:0.16" EasingFunction="{StaticResource SettleEase}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource PressedOverlay}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Pop" Storyboard.TargetProperty="ScaleX"
                                                         To="0.9" Duration="0:0:0.07" />
                                        <DoubleAnimation Storyboard.TargetName="Pop" Storyboard.TargetProperty="ScaleY"
                                                         To="0.9" Duration="0:0:0.07" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Pop" Storyboard.TargetProperty="ScaleX"
                                                         To="1" Duration="0:0:0.14" EasingFunction="{StaticResource SettleEase}" />
                                        <DoubleAnimation Storyboard.TargetName="Pop" Storyboard.TargetProperty="ScaleY"
                                                         To="1" Duration="0:0:0.14" EasingFunction="{StaticResource SettleEase}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>

                        <!-- An application whose window is in front: the highlight the bar has always put
                             on it, plus one bounce as it arrives. A pinned icon carries no IsForeground,
                             so this never fires for one. -->
                        <DataTrigger Binding="{Binding IsForeground}" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource AccentSoft}" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Pop"
                                                                       Storyboard.TargetProperty="ScaleX">
                                            <EasingDoubleKeyFrame KeyTime="0:0:0.07" Value="1.18" EasingFunction="{StaticResource LiftEase}" />
                                            <EasingDoubleKeyFrame KeyTime="0:0:0.18" Value="0.96" />
                                            <EasingDoubleKeyFrame KeyTime="0:0:0.34" Value="1" EasingFunction="{StaticResource SettleEase}" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Pop"
                                                                       Storyboard.TargetProperty="ScaleY">
                                            <EasingDoubleKeyFrame KeyTime="0:0:0.07" Value="1.18" EasingFunction="{StaticResource LiftEase}" />
                                            <EasingDoubleKeyFrame KeyTime="0:0:0.18" Value="0.96" />
                                            <EasingDoubleKeyFrame KeyTime="0:0:0.34" Value="1" EasingFunction="{StaticResource SettleEase}" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Small square action button used inside list rows -->
    <Style x:Key="ChipButton" TargetType="Button" BasedOn="{StaticResource BarButton}">
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="26" />
        <Setter Property="FontFamily" Value="{DynamicResource IconFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
        <Setter Property="ToolTipService.InitialShowDelay" Value="250" />
    </Style>

    <!-- A tab on the Start menu's right-hand pane. The underline under the active one is a separate
         Border in the XAML, because a button template cannot reach outside itself. -->
    <Style x:Key="StartTabButton" TargetType="Button" BasedOn="{StaticResource BarButton}">
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="FontFamily" Value="{StaticResource TextFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
    </Style>

    <!-- One background application in the notification-area flyout. -->
    <Style x:Key="TrayItemRow" TargetType="Button" BasedOn="{StaticResource BarButton}">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
    </Style>

    <!-- One window of a grouped application in the hover preview: the picture on the left, the
         title beside it, and a close cross on the right. -->
    <Style x:Key="RunningPreviewRow" TargetType="Button" BasedOn="{StaticResource BarButton}">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Row" Background="Transparent" CornerRadius="6" Padding="6">
                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{StaticResource HoverOverlay}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{StaticResource PressedOverlay}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Glyph" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource IconFont}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    </Style>

    <Style x:Key="Caption" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource TextFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    </Style>

    <Style x:Key="CaptionDim" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
    </Style>

    <Style x:Key="PopupCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource FlyoutBackground}" />
        <Setter Property="BorderBrush" Value="{StaticResource FlyoutBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="10" />
    </Style>

    <!-- Volume bar drawn straight into the bar: thin track, invisible but grabbable thumb -->
    <Style x:Key="VolumeBarSlider" TargetType="Slider">
        <Setter Property="Height" Value="6" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="100" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Background="Transparent">
                        <Border Height="4" CornerRadius="2" VerticalAlignment="Center"
                                Background="{StaticResource TrackRest}" />
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="4" CornerRadius="2" VerticalAlignment="Center"
                                                    Background="{StaticResource Accent}" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Width="16" Height="16" Focusable="False">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="Transparent" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Taller slider with a visible handle, used inside the volume flyout -->
    <Style x:Key="VolumeFlyoutSlider" TargetType="Slider" BasedOn="{StaticResource VolumeBarSlider}">
        <Setter Property="Height" Value="20" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Background="Transparent">
                        <Border Height="6" CornerRadius="3" VerticalAlignment="Center"
                                Background="{StaticResource TrackRest}" />
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="6" CornerRadius="3" VerticalAlignment="Center"
                                                    Background="{StaticResource Accent}" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Width="14" Height="14" Focusable="False">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Ellipse Fill="#FFFFFFFF" Width="14" Height="14" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ResultRow" TargetType="ListBoxItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Row" CornerRadius="6" Background="Transparent" Padding="8,6">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{StaticResource HoverOverlay}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{StaticResource AccentSoft}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FlyoutList" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource ResultRow}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    </Style>

</ResourceDictionary>
