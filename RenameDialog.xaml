<Window x:Class="DevShell.RenameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:DevShell.UI"
        Title="{l:Tr Dlg_Rename}"
        Width="380"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource TextFont}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <Style x:Key="DialogButton" TargetType="Button" BasedOn="{StaticResource BarButton}">
            <Setter Property="Width" Value="84" />
            <Setter Property="Height" Value="30" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Background" Value="#1FFFFFFF" />
        </Style>
    </Window.Resources>

    <!-- The card is the whole window, so it is also what the pointer drags. -->
    <Border Background="{StaticResource FlyoutBackground}"
            BorderBrush="{StaticResource FlyoutBorder}"
            BorderThickness="1"
            CornerRadius="10"
            Padding="18"
            MouseLeftButtonDown="Chrome_MouseLeftButtonDown">
        <StackPanel>
            <TextBlock x:Name="PromptText"
                       Text="{l:Tr Dlg_Rename}"
                       FontSize="14"
                       Foreground="{StaticResource TextPrimary}"
                       TextWrapping="Wrap" />

            <Border Margin="0,12,0,0"
                    Background="#14FFFFFF"
                    BorderBrush="{StaticResource FlyoutBorder}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="8,5">
                <TextBox x:Name="NameBox"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="{StaticResource TextPrimary}"
                         CaretBrush="{StaticResource TextPrimary}"
                         SelectionBrush="{StaticResource Accent}"
                         FontSize="13" />
            </Border>

            <TextBlock x:Name="ErrorText"
                       Margin="2,8,0,0"
                       FontSize="12"
                       Foreground="#FFFF9B9B"
                       TextWrapping="Wrap"
                       Visibility="Collapsed" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button x:Name="OkButton" Style="{StaticResource DialogButton}" Content="{l:Tr Dlg_OK}"
                        Background="{StaticResource Accent}" IsDefault="True" Click="Ok_Click" />
                <Button Style="{StaticResource DialogButton}" Content="{l:Tr Dlg_Cancel}"
                        Margin="8,0,0,0" IsCancel="True" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
